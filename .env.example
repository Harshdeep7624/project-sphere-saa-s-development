# =============================================================================
# ProjectSphere — Production Environment Variables Reference
# =============================================================================
# Copy this file to .env.local for local development.
# In production on Vercel, configure these variables in:
# Project Settings > Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas recommended for production).
# Ensure your MongoDB Atlas Network Access whitelist includes 0.0.0.0/0 (or Vercel IPs).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Required)
# -----------------------------------------------------------------------------
# High-entropy random secret string used to sign and verify JWT session cookies.
# Generate a secure 64-character secret with: openssl rand -base64 48
JWT_SECRET=your-production-jwt-secret-at-least-32-characters-long

# -----------------------------------------------------------------------------
# 3. APPLICATION CANONICAL URL (Recommended)
# -----------------------------------------------------------------------------
# Canonical origin used for OpenGraph metadata, SEO tags, and absolute URLs.
NEXT_PUBLIC_APP_URL=https://your-production-domain.vercel.app

# -----------------------------------------------------------------------------
# 4. DISTRIBUTED RATE LIMITING (Recommended for Multi-Instance Serverless)
# -----------------------------------------------------------------------------
# Upstash Redis REST API credentials.
# When provided, ProjectSphere enforces atomic, shared rate limits across all
# concurrent Vercel serverless instances (protecting login, register, and password changes).
# When omitted, ProjectSphere automatically falls back to local in-memory rate limiting.
# Setup: Add "Upstash Redis" from the Vercel Marketplace or at https://upstash.com
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# -----------------------------------------------------------------------------
# 5. INITIAL ADMIN BOOTSTRAP (Optional - used by: pnpm run seed:admin)
# -----------------------------------------------------------------------------
# Used only when running the administrative seed script to bootstrap the first admin.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@projectsphere.edu
ADMIN_PASSWORD=your-secure-admin-password
